@article{Fabbri2022Inequality,
  title     = {Inequality and inequity in network-based ranking and recommendation algorithms},
  author    = {Fabbri, Francesco and Bonchi, Francesco and Boratto, Ludovico and Castillo, Carlos},
  journal   = {Scientific Reports},
  year      = {2022},
  volume    = {12},
  pages     = {2012},
  doi       = {10.1038/s41598-022-05434-1},
  descricao = {Examina desigualdade e inequidade em algoritmos de ranking baseados em redes, incluindo PageRank e Who-to-Follow. Utiliza coeficiente de Gini para medir desigualdade na distribuição de valores de PageRank em redes sociais dirigidas. Demonstra que desigualdade está positivamente correlacionada com inequidade, sendo impulsionada pela interação entre preferential attachment, homofilia, atividade de nós e densidade de arestas. Estudo fundamental para compreender como estrutura de rede afeta concentração de centralidade.}
}

