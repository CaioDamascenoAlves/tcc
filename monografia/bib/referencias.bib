@article{Newman2006Modularity,
  title     = {Modularity and community structure in networks},
  author    = {Newman, M. E. J.},
  journal   = {Proceedings of the National Academy of Sciences},
  year      = {2006},
  volume    = {103},
  number    = {23},
  pages     = {8577--8582},
  doi       = {10.1073/pnas.0601602103},
  descricao = {Trabalho seminal que formaliza o conceito de modularidade como métrica quantitativa para avaliar qualidade de partições de comunidades em redes. Define modularidade Q como diferença entre fração de arestas intra-comunidade observada versus esperada em grafo aleatório com mesma distribuição de graus. Estabelece que Q > 0.3 indica estrutura de comunidades significativa, fornecendo benchmark fundamental para validação de algoritmos de detecção. Demonstra propriedades matemáticas da modularidade e suas limitações, incluindo limite de resolução que impede detecção de comunidades pequenas em redes grandes. Artigo fundamental para toda pesquisa subsequente em detecção de comunidades.}
}

